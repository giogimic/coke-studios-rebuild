property pID, pParentWindowon new me, id, parentwindow  pID = id  pParentWindow = parentwindow  return meendon mouseDown me  global gCatalog, oIsoScene  oItemsList = pParentWindow.pScrollingLists.itemslist  aItem = oItemsList.pItemsList[pID]  oItem = gCatalog.getItemByProdId(aItem[#prodID])  if voidp(oIsoScene) then    return   end if  iPosId = integer(101058)  if not voidp(oItem) then    sImageBase = oItem[#imageBase]    sType = oItem[#type]    sAction = oItem[#Action]    sCastLib = "Furniture"    iRow = -1000    iCol = 0    iGridY = 0    iState = oItem[#state]    sAttributes = oItem[#attributes]    iDirection = 2    iHeight = oItem[#height]    bItemsAllowedOnTop = 1    iHeightOffset = 0    iCatId = aItem[#prodID]    if voidp(iState) or (iState = EMPTY) then      iState = 0    end if    if voidp(sAttributes) or (sAttributes = EMPTY) then      aAttributes = [:]    else      aAttributes = value(sAttributes)    end if    if voidp(iDirection) or (iDirection = EMPTY) then      iDirection = 2    end if    if voidp(bItemsAllowedOnTop) or (bItemsAllowedOnTop = EMPTY) then      bItemsAllowedOnTop = 1    end if    oFurnitureItem = oIsoScene.createItem(iCatId, iPosId, sImageBase, sType, sAction, iState, aAttributes, sCastLib, iRow, iCol, iGridY, iDirection, iHeight, iHeightOffset, bItemsAllowedOnTop)    oFurnitureItem.update(1)    if oFurnitureItem.ancestor.sType = "Poster" then      if voidp(oFurnitureItem.ancestor.oRightWallMember) then      else        theMember = oFurnitureItem.ancestor.oRightWallMember        if (ilk(theMember) = #member) and (theMember.type = #filmLoop) then          repeat with i = 1 to the lastChannel            if sprite(i).member = theMember then              sprite(i).member = member("emptyX")              sprite(i).visible = 0              return             end if          end repeat        else          if not voidp(theMember.image) then            put "DEBUG: Image dimensions: " & theMember.image.width & "x" & theMember.image.height            tSourceImage = theMember.image          else          end if        end if      end if      if not voidp(tSourceImage) then        previewSize = 108        tFinalImage = image(previewSize, previewSize, 32)        imgWidth = tSourceImage.width        imgHeight = tSourceImage.height        if (imgWidth > previewSize) or (imgHeight > previewSize) then          scaleFactorW = previewSize / float(imgWidth)          scaleFactorH = previewSize / float(imgHeight)          scaleFactor = min(scaleFactorW, scaleFactorH)          if scaleFactor <= 0 then            put "ERROR: Invalid scaleFactor (<= 0), forcing to 1.0"            scaleFactor = 1.0          end if          newWidth = max(1, integer((imgWidth * scaleFactor) + 0.5))          newHeight = max(1, integer((imgHeight * scaleFactor) + 0.5))        else          scaleFactor = min(previewSize / imgWidth, previewSize / imgHeight)          newWidth = integer(imgWidth * scaleFactor)          newHeight = integer(imgHeight * scaleFactor)        end if        tScaledImage = image(newWidth, newHeight, 32)        tScaledImage.copyPixels(tSourceImage, tScaledImage.rect, tSourceImage.rect, [#dither: 0])        offsetX = integer((previewSize - newWidth) / 2)        offsetY = integer((previewSize - newHeight) / 2)        destRect = rect(offsetX, offsetY, offsetX + newWidth, offsetY + newHeight)        tFinalImage.copyPixels(tScaledImage, destRect, tScaledImage.rect, [#dither: 0])        tSourceImage = tFinalImage        put "Final preview image size: " & tSourceImage.width & "x" & tSourceImage.height        member("cc.catalogue.previewbox").image = tSourceImage        member("cc.catalogue.previewbox").regPoint = point(0, 0)        oFurnitureItem.destroy()      else        put "No valid image for preview."      end if      return     else      aCombinedImages = []      minX = 0      minY = 0      maxX = 0      maxY = 0      if count(oFurnitureItem.ancestor.aAssets) > 0 then        aPatterns = ["0_1_1_2_0", "0_2_1_2_0", "0_2_2_0_0", "0_1_1_0_0", "0_3_1_2_0"]        sMatchPattern = EMPTY        repeat with p = 1 to aPatterns.count          pattern = aPatterns[p]          repeat with i = 1 to count(oFurnitureItem.ancestor.aAssets)            if oFurnitureItem.ancestor.aAssets[i].name contains pattern then              sMatchPattern = pattern              exit repeat            end if          end repeat          if sMatchPattern <> EMPTY then            exit repeat          end if        end repeat        if sMatchPattern <> EMPTY then          aRawAssets = []          repeat with i = 1 to count(oFurnitureItem.ancestor.aAssets)            asset = oFurnitureItem.ancestor.aAssets[i]            if asset.name contains sMatchPattern then              aRawAssets.append(asset)            end if          end repeat          aDrawSequence = ["_a_", "_b_", "_c_", "_d_", "_e_", "_f_"]          aSortedAssets = []          repeat with j = 1 to aDrawSequence.count            pattern = aDrawSequence[j]            repeat with k = 1 to aRawAssets.count              if aRawAssets[k].name contains pattern then                aSortedAssets.append(aRawAssets[k])              end if            end repeat          end repeat          aCombinedImages = []          minX = 0          minY = 0          maxX = 0          maxY = 0          repeat with i = 1 to aSortedAssets.count            asset = aSortedAssets[i]            img = asset.image            reg = asset.regPoint            sAname = asset.name            aCombinedImages.append([#image: img, #reg: reg, #name: sAname])            left = -reg[1]            top = -reg[2]            right = left + img.width            bottom = top + img.height            if left < minX then              minX = left            end if            if top < minY then              minY = top            end if            if right > maxX then              maxX = right            end if            if bottom > maxY then              maxY = bottom            end if          end repeat        end if        if count(aCombinedImages) > 0 then          totalWidth = maxX - minX          totalheight = maxY - minY          if (totalWidth > 0) and (totalheight > 0) then            tComposite = image(totalWidth, totalheight, 32)            repeat with i = 1 to count(aCombinedImages)              img = aCombinedImages[i][#image].duplicate()              reg = aCombinedImages[i][#reg]              pasteX = -reg[1] - minX              pasteY = -reg[2] - minY              destRect = rect(pasteX, pasteY, pasteX + img.width, pasteY + img.height)              if not voidp(oItem[#attributes]) and not voidp(oItem[#attributes][#color_small]) then                if oItem[#imageBase] = "blocks" then                  assetName = aCombinedImages[i][#name]                  if (assetName contains "_d_") or (assetName contains "_c_") then                    myColor = rgb(oItem[#attributes][#color_small])                  else                    myColor = rgb(255, 255, 255)                  end if                else                  myColor = rgb(255, 255, 255)                end if              else                myColor = rgb(255, 255, 255)              end if              matte = img.createMatte()              tComposite.copyPixels(img, destRect, img.rect, [#maskImage: matte, #bgColor: myColor])            end repeat            previewSize = 108            if (totalWidth > previewSize) or (totalheight > previewSize) then              scaleFactorW = previewSize / float(totalWidth)              scaleFactorH = previewSize / float(totalheight)              scaleFactor = min(scaleFactorW, scaleFactorH)              if scaleFactor <= 0 then                put "ERROR: Invalid scaleFactor (<= 0), forcing to 1.0"                scaleFactor = 1.0              end if              newWidth = max(1, integer((totalWidth * scaleFactor) + 0.5))              newHeight = max(1, integer((totalheight * scaleFactor) + 0.5))            else              scaleFactor = min(previewSize / tComposite.width, previewSize / tComposite.height)              newWidth = max(1, integer(tComposite.width * scaleFactor))              newHeight = max(1, integer(tComposite.height * scaleFactor))            end if            tScaledImage = image(newWidth, newHeight, 32)            tScaledImage.copyPixels(tComposite, tScaledImage.rect, tComposite.rect, [#dither: 0])            tFinalImage = image(previewSize, previewSize, 32)            offsetX = integer((previewSize - newWidth) / 2)            offsetY = integer((previewSize - newHeight) / 2)            destRect = rect(offsetX, offsetY, offsetX + newWidth, offsetY + newHeight)            tFinalImage.copyPixels(tScaledImage, destRect, tScaledImage.rect, [#dither: 0])            tSourceImage = tFinalImage          else            tSourceImage = aCombinedImages[1][#image]          end if        else          tSourceImage = oFurnitureItem.ancestor.aAssets[1].image        end if      else        tSourceImage = oFurnitureItem.ancestor.aAssets[1].image      end if    end if    if not voidp(tSourceImage) then      put "Final preview image size: " & tSourceImage.width & "x" & tSourceImage.height      member("cc.catalogue.previewbox").image = tSourceImage      member("cc.catalogue.previewbox").regPoint = point(0, 0)    else      put "No valid image for preview."    end if  end ifendon findFreeChannel  repeat with i = 1 to 1000    if voidp(sprite(i)) then      return i    end if  end repeat  return 1000endon round x  return integer(x + 0.5)end