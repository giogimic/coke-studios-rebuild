property ancestorglobal oIsoSceneon new me, _sProdId, _sPosId, _sImageBase, _sType, _sAction, _iState, _aAttributes, _sCastLib, _iRow, _iCol, _iGridY, _iDirection, _iHeight, _iHeightOffset, bItemsAllowedOnTop  me.ancestor = script("FurnitureItem").new(_sProdId, _sPosId, _sImageBase, _sType, _sAction, _iState, _aAttributes, _sCastLib, _iRow, _iCol, _iGridY, _iDirection, _iHeight, _iHeightOffset, bItemsAllowedOnTop)  put "STEP 15"  (the actorList).add(me)  put "STEP 16"  oIsoScene.oFurniture.addItem(me)  put "STEP 17"  put "default aAttributes:" && _aAttributes  put "STEP 18"  me.oAction = script("ACTION_" & me.sAction).new(me, me.iState, me.aAttributes)  put "STEP 19"  return meendon getHeight me  return me.ancestor.getHeight()end